                function key_holes_case_fn() {
                    

                // creating part 0 of case key_holes
                let key_holes__part_0 = holes_extrude_2_outline_fn();

                // make sure that rotations are relative
                let key_holes__part_0_bounds = key_holes__part_0.getBounds();
                let key_holes__part_0_x = key_holes__part_0_bounds[0].x + (key_holes__part_0_bounds[1].x - key_holes__part_0_bounds[0].x) / 2
                let key_holes__part_0_y = key_holes__part_0_bounds[0].y + (key_holes__part_0_bounds[1].y - key_holes__part_0_bounds[0].y) / 2
                key_holes__part_0 = translate([-key_holes__part_0_x, -key_holes__part_0_y, 0], key_holes__part_0);
                key_holes__part_0 = rotate([0,0,0], key_holes__part_0);
                key_holes__part_0 = translate([key_holes__part_0_x, key_holes__part_0_y, 0], key_holes__part_0);

                key_holes__part_0 = translate([0,0,0], key_holes__part_0);
                let result = key_holes__part_0;
                
            
                    return result;
                }
            
            
        
            function main() {
                return key_holes_case_fn();
            }

        